# Get this from https://aistudio.google.com/apikey (free, no KYC)
GEMINI_API_KEY=your_key_here

# Which model to use for transformation. Check your AI Studio console for
# whichever flash model is currently available on your account - model
# names get retired/renamed over time (this one has already changed once).
GEMINI_MODEL=gemini-3.6-flash

# Text-to-speech model and prebuilt voice for the "Read aloud" feature.
# Kore is a solid general-purpose default; see the Gemini TTS docs for the
# full voice list if you want to try others.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# CORS: the origin your frontend is served from during development.
# Capacitor apps load from a different origin (capacitor://localhost), so
# this list needs that too once you get to Phase 7.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,capacitor://localhost
